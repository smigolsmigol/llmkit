{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [
    "@biomejs/biome",
    "c8",
    "kguard",
    "supabase"
  ],
  "exclude": ["types", "exports"],
  "ignore": [
    "examples/**",
    "scripts/**",
    ".semgrep/llmkit-security.ts"
  ],
  "workspaces": {
    ".": {
      "entry": ["test/*.mjs"]
    },
    "packages/proxy": {
      "ignore": ["test/**"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/sdk": {
      "entry": ["test/*.mjs"]
    },
    "packages/cli": {
      "entry": ["test/*.mjs"]
    },
    "packages/ai-sdk-provider": {
      "entry": ["test/*.mjs"]
    },
    "packages/mcp-server": {
      "entry": ["test/*.mjs"]
    },
    "packages/dashboard": {
      "entry": [
        "open-next.config.ts",
        "test/*.mjs",
        "test/fixtures/*.ts"
      ],
      "ignoreDependencies": ["class-variance-authority"],
      "ignore": [
        "src/components/ui/card.tsx"
      ]
    }
  }
}
