{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llmkit-web",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "llmkit.sh",
      "custom_domain": true
    },
    {
      "pattern": "www.llmkit.sh",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "llmkit-web"
    }
  ],
  "vars": {
    "LLMKIT_DEPLOYMENT_MODE": "public-recovery"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "llmkit-web-staging"
        }
      ],
      "vars": {
        "LLMKIT_DEPLOYMENT_MODE": "public-recovery"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}
