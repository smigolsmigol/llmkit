{
  "name": "@f3d1/llmkit-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "LLMKit dashboard - cost analytics, API key management, budget configuration",
  "scripts": {
    "dev": "next dev",
    "prebuild": "corepack pnpm@9.15.4 --filter @f3d1/llmkit-shared build",
    "build": "next build",
    "cloudflare:build": "node scripts/build-cloudflare.mjs",
    "cloudflare:preview": "node scripts/build-cloudflare.mjs --env staging && opennextjs-cloudflare preview --env staging",
    "cloudflare:dry-run": "node scripts/build-cloudflare.mjs --env staging && wrangler deploy --dry-run --env staging",
    "cloudflare:deploy:staging": "node scripts/build-cloudflare.mjs --env staging && opennextjs-cloudflare deploy --env staging",
    "cloudflare:deploy:production": "node scripts/build-cloudflare.mjs && opennextjs-cloudflare deploy",
    "cloudflare:typegen": "wrangler types --env staging --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node test/recovery-boundary-test.mjs && node test/public-content-contract-test.mjs",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@f3d1/llmkit-shared": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^0.577.0",
    "next": "15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10",
    "playwright": "1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
