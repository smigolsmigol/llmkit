# LLMKit local development
# Copy to .env and fill in values

# Provider API keys (for local CLI testing)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Proxy secrets. Use a modern sb_secret_* key or a legacy service_role JWT;
# do not use an anon/publishable key. Scope hosted writes to the explicit Wrangler environment.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=sb_secret_...
# ENCRYPTION_KEY=base64-encoded-32-byte-key
# DEV_MODE=true

# Hosted staging budget proof. Do not store real values in this file or in the repository.
# The base URL must be the isolated llmkit-proxy-staging workers.dev origin.
# LLMKIT_STAGING_BASE_URL=https://llmkit-proxy-staging.your-account.workers.dev
# LLMKIT_STAGING_CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# LLMKIT_STAGING_SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# LLMKIT_PRODUCTION_SUPABASE_PROJECT_REF=zyxwvutsrqponmlkjihg
# LLMKIT_STAGING_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# LLMKIT_STAGING_PROOF_TOKEN=...
# LLMKIT_STAGING_SUPABASE_KEY=sb_secret_...
# LLMKIT_STAGING_PROVIDER_KEY=...
# LLMKIT_STAGING_PROVIDER=openai
# LLMKIT_STAGING_MODEL=gpt-5-mini
# LLMKIT_HOSTED_PROOF_APPROVED=staging:llmkit-proxy-staging.your-account.workers.dev:db:abcdefghijklmnopqrst

# Dashboard server environment
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SERVICE_KEY=server-only-secret-for-key-material-and-admin-operations
