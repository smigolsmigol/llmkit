{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**/*.ts",
      "packages/*/src/**/*.tsx",
      "packages/*/test/**/*.js",
      "packages/*/test/**/*.jsx",
      "packages/*/test/**/*.mjs",
      "packages/*/test/**/*.cjs",
      "packages/*/test/**/*.ts",
      "packages/*/test/**/*.tsx",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "scripts/**/*.cjs",
      "scripts/**/*.ts",
      "test/**/*.js",
      "test/**/*.mjs",
      "test/**/*.cjs",
      "test/**/*.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noFallthroughSwitchClause": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      }
    }
  },
  "formatter": {
    "enabled": false
  }
}
